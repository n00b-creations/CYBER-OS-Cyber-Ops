# JARVIS-SEC API runtime configuration
PORT=8787

# OIDC provider. All three values are required for authenticated API routes.
AUTH_ISSUER=https://YOUR-IDP.example.com/
AUTH_AUDIENCE=jarvis-sec-api
AUTH_JWKS_URL=https://YOUR-IDP.example.com/.well-known/jwks.json

# Browser CORS allowlist. Never use * for authenticated production traffic.
CORS_ALLOWED_ORIGINS=https://app.example.com
RATE_LIMIT_PER_MINUTE=120
MAX_BODY_BYTES=65536

# PostgreSQL. Required for marketplace production; memory is development-only.
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/jarvis
DB_POOL_MAX=10
DB_SSL=true

# Development-only seed organization for MemoryCrmRepository.
# Never use the memory adapter in production.
DEV_ORG_ID=dev-organization
