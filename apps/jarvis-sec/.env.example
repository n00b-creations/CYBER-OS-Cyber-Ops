# JARVIS-SEC browser configuration
VITE_API_BASE_URL=http://localhost:8787

# OIDC public client. Configure the provider for Authorization Code + PKCE.
VITE_OIDC_ISSUER=https://YOUR-IDP.example.com/
VITE_OIDC_CLIENT_ID=YOUR_PUBLIC_CLIENT_ID
VITE_OIDC_AUDIENCE=jarvis-sec-api
VITE_OIDC_SCOPES=openid profile email

# Development-only API bridge. Never place production credentials here.
VITE_DEV_ACCESS_TOKEN=
