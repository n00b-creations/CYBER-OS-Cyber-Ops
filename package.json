{
  "name": "cyber-os",
  "version": "0.1.0",
  "description": "Modular desktop-first cyber operations workspace platform",
  "type": "module",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=apps/web",
    "build": "npm run build -ws",
    "build:packages": "npm run build --ws --workspaces-update-depth 1",
    "test": "npm run test -ws",
    "lint": "npm run lint -ws",
    "type-check": "npm run type-check -ws"
  },
  "devDependencies": {
    "typescript": "^5.3.0",
    "@types/node": "^20.10.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
